# Alex-Nano-Bot Configuration
# Скопируйте в .env и заполните.
# ВАЖНО: многострочные значения не работают — системные промпты задавайте
# ОДНОЙ строкой в двойных кавычках, переносы внутри промпта — как \n.

# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# ID админов через запятую: безлимит по лимитам, /providers, /models, /limits и т.д.
ADMIN_IDS=123456789,987654321

# ============================================
# LLM провайдеры
# ============================================

# Groq — основной провайдер (+ vision-модель и whisper)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter — обязательный fallback
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Дополнительные провайдеры (опционально)
# ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENAI_API_KEY=your_openai_key_here

# Автоматический фоллбэк между провайдерами
ENABLE_MULTI_PROVIDER=true
MAX_PROVIDER_RETRIES=3
PROVIDER_HEALTH_CHECK_INTERVAL=60

# ============================================
# Модели (актуальны на октябрь 2026)
# Groq перевёл llama-3.x/mixtral в Enterprise-only — на self-serve ключах они дают 404.
# Список для вашего ключа:
# curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# ============================================
FASTBOT_MODEL=openai/gpt-oss-20b
SKILLBOT_MODEL=openai/gpt-oss-20b
PLANBOT_MODEL=openai/gpt-oss-120b
# Бюджет LLM-вызовов PlanBot на одно планирование (план + шаги + итог): 4 — до 2 шагов, влезает в
# бесплатный лимит Groq 8000 токенов/мин; 7 — расширенный режим (до 5 шагов) для платного тарифа
PLANBOT_MAX_CALLS=4
# Мультимодальная модель Groq для анализа фото (3 картинки/запрос, 20 МБ)
VISION_MODEL=qwen/qwen3.8-27b
# Распознавание голоса
WHISPER_MODEL=whisper-large-v3

# ============================================
# Голос
# ============================================
MAX_VOICE_DURATION=300
ENABLE_VOICE_IN_GROUPS=true

# ============================================
# База данных и векторное хранилище
# ============================================
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
VECTOR_STORE_PATH=data/vector_store
# Модель эмбеддингов (fastembed) — от неё зависит качество поиска по памяти и корпусу витрин.
#   sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 — по умолчанию; ~0,5 ГБ ОЗУ.
#       Видит только первые 128 токенов текста (по оценке ~400–500 символов чанка) — длинные фрагменты ищутся хуже
#   sentence-transformers/paraphrase-multilingual-mpnet-base-v2 — 1,0 ГБ на диске, ~1,3 ГБ ОЗУ, 512 токенов
#   intfloat/multilingual-e5-large — лучшее качество поиска по-русски: 2,2 ГБ на диске, ~3 ГБ ОЗУ
#       на процесс (бот и витрина — отдельные процессы), 512 токенов. Поднимите BOT_MEM_LIMIT /
#       SHOWCASE_MEM_LIMIT (например 3500m) и проверьте `free -h`
# После смены модели при перезапуске индексы (memories, skills, conversations, corpus*)
# перестраиваются автоматически из сохранённых текстов — минуты, данные не теряются.
# Перезапускайте бота и витрину вместе. Старое значение all-MiniLM-L6-v2 игнорируется (модель английская).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Кэш модели на томе data — не скачивается заново при пересоздании контейнера
EMBEDDING_CACHE_DIR=data/models
# Токен HuggingFace (huggingface.co/settings/tokens, права read): быстрее скачивание, без лимитов анонимов
# HF_TOKEN=hf_...

# ============================================
# База знаний
# ============================================
# ID каналов через запятую (например -1001234567890)
KB_CHANNEL_IDS=
# Статьи старше N дней считаются устаревшими и обновляются при обращении
KB_STALE_DAYS=30

# ============================================
# Веб-поиск (рекомендуется Serper; без ключей — бесплатный DuckDuckGo)
# ============================================
ENABLE_WEB_SEARCH=true
SERPER_API_KEY=
# SERPAPI_KEY=
# BING_API_KEY=
WEB_SEARCH_RESULTS=3

# ============================================
# Мультиюзерность и лимиты
# ============================================
# true — бот отвечает всем, кроме забаненных (/ban, /unban); false — только админы
BOT_OPEN_ACCESS=false
# Суточный лимит сообщений на пользователя (0 — безлимит; перекрывается командой /setlimit)
USER_DAILY_MESSAGE_LIMIT=50

# ============================================
# Runtime VM
# ============================================
# Инструменты call_tool, доступные НЕ-админам (через запятую; MCP: <server>__<tool>).
# Админам доступно всё. user_id навыку всегда подставляется из контекста VM.
RUNTIME_USER_TOOLS=validated_answer

# ============================================
# MCP-серверы (внешние инструменты; статус: /mcp, admin)
# ============================================
# JSON-список одной строкой. stdio (требует uv, уже в образе) или Streamable HTTP:
# MCP_SERVERS=[{"name":"fetch","command":"uvx","args":["mcp-server-fetch"]}]
# MCP_SERVERS=[{"name":"remote","url":"https://host/mcp"}]
MCP_SERVERS=

# ============================================
# SSRF-защита исходящих запросов по URL пользователей
# ============================================
# false (по умолчанию): knowledge_base / site_monitor не ходят на localhost, 10.x,
# 192.168.x, 169.254.x и т.п. true — разрешить (например, мониторинг своей LAN админом).
ALLOW_PRIVATE_URLS=false

# ============================================
# Витрины службы поддержки (отдельный сервис, один процесс на все витрины)
# Запуск: docker compose --profile showcase up -d showcase
# После обновления кода: docker compose build showcase (код копируется в образ,
# «up -d» без build изменения не подхватит)
# ============================================
# Несколько витрин в одном процессе: у каждой свой бот, корпус знаний, доступ и группа оператора.
# JSON-список ОДНОЙ строкой. Поля: slug (a-z0-9_, обязателен), token или token_env (имя переменной
# с токеном — так токены не лежат в общем JSON), collection (по умолчанию corpus_<slug>; для уже
# загруженного корпуса «corpus»), access: "invite" (по умолчанию, по приглашению) или "open",
# operator_chat_id (группа оператора этой витрины, 0 — без оператора), name, welcome,
# system_prompt, model (пусто — общие SHOWCASE_SYSTEM_PROMPT / SHOWCASE_MODEL).
# Пример (две закрытые витрины, каждая со своей группой оператора):
# SHOWCASES=[{"slug":"reklama","token_env":"SHOWCASE_BOT_TOKEN","collection":"corpus","operator_chat_id":-1001111111111},{"slug":"jurist","token_env":"JURIST_BOT_TOKEN","operator_chat_id":-1002222222222}]
# JURIST_BOT_TOKEN=123456:AAA...
# Приглашения выдаёт администратор из самой витрины: /invite, /allow, /members (см. README).
# Не задано — одна витрина по SHOWCASE_BOT_TOKEN и прежним переменным (OPERATOR_CHAT_ID,
# SHOWCASE_OPEN_ACCESS), коллекция «corpus».
SHOWCASES=
# Токен демо-бота (пусто и нет SHOWCASES — сервис витрины не запускается)
SHOWCASE_BOT_TOKEN=
SHOWCASE_MODEL=openai/gpt-oss-20b
# Только без SHOWCASES: витрина открыта для всех (основной бот остаётся приватным).
# Не задано (или пусто) — как BOT_OPEN_ACCESS. При SHOWCASES доступ задаётся полем access
# SHOWCASE_OPEN_ACCESS=true
# Суточный лимит LLM-ответов витрин на пользователя, общий для всех витрин (UTC; 0 — безлимит;
# админы не ограничены).
# Вопросы без ответа в базе знаний лимит не тратят. Открывая витрину всем, не ставьте 0 —
# каждый ответ идёт в платную LLM на ваш ключ
SHOWCASE_DAILY_LIMIT=20

# Сколько воспоминаний подмешивать в RAG-контекст Planner на запрос (0 — не подмешивать)
RAG_MEMORIES=10
# Размер чанка корпуса / наложение / сколько чанков идёт в контекст ответа.
# Модель эмбеддингов по умолчанию видит только 128 токенов (~400–500 символов): чанк 450 влезает
# в неё целиком, а 1200 индексировался бы по первой трети. Для моделей с окном 512 токенов
# (paraphrase-multilingual-mpnet-base-v2, multilingual-e5-large) ставьте 1200 / 200 / 5.
# Менять имеет смысл вместе с повторной загрузкой документов: старые чанки не перерезаются
# (повторная загрузка файла с тем же именем заменяет прежнюю версию)
CORPUS_CHUNK_SIZE=450
CORPUS_CHUNK_OVERLAP=80
CORPUS_TOP_K=8

# ============================================
# Логирование
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# ============================================
# Приложение
# ============================================
APP_NAME=Alex-Nano-Bot
APP_VERSION=1.12.0

# ============================================
# Системные промпты (опционально — есть вшитые дефолты).
# ОДНОЙ строкой, значение — В ДВОЙНЫХ кавычках, переносы как \n (без кавычек \n
# останется буквальными символами). Переменная ЗАМЕНЯЕТ встроенный промпт целиком:
# - PLANNER_SYSTEM_PROMPT должен содержать полную схему DSL (plan, call_llm, respond,
#   store_memory, call_tool и их params) — приложение схему отдельно не передаёт;
# - SHOWCASE_SYSTEM_PROMPT должен требовать ответа строго по блоку «БАЗА ЗНАНИЙ»
#   (поиск не отсекает нерелевантные фрагменты, промпт — единственная защита).
# Не уверены — не задавайте переменную, применится встроенный промпт.
# ============================================
# FASTBOT_SYSTEM_PROMPT="Ты — быстрый ассистент...\n\nПРАВИЛА\n1. ..."
# PLANBOT_SYSTEM_PROMPT="..."
# SKILLBOT_SYSTEM_PROMPT="..."
# PLANNER_SYSTEM_PROMPT="..."
# SHOWCASE_SYSTEM_PROMPT="..."

# ============================================
# Шифрование API-ключей в БД (нужно для /providers)
# ============================================
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_key_here

# Часовой пояс ответов и планировщика (IANA: Europe/Moscow, Asia/Irkutsk, UTC, ...)
BOT_TIMEZONE=Europe/Moscow

# ============================================
# BYOK: пользователи подключают свои API-ключи (/byok set <провайдер> <ключ>)
# С ключом запросы идут только на него (без фолбэка на ключи бота), лимиты не применяются.
# Требует ENCRYPTION_KEY
# ============================================
BYOK_ENABLED=true

# ============================================
# Эскалация на оператора в витрине: ID супергруппы поддержки с включёнными темами
# (бот — админ с правом управлять темами). 0 — выключено.
# Только без SHOWCASES; при SHOWCASES группа задаётся полем operator_chat_id каждой витрины
# ============================================
OPERATOR_CHAT_ID=0

# ============================================
# Биллинг: пакеты запросов сверх бесплатного суточного лимита (1 кредит = 1 сообщение).
# Провайдеры через запятую: stars (без токена), yookassa, stripe (токены из @BotFather -> Payments).
# Пусто — биллинг выключен. Каталог пакетов — JSON в CREDIT_PACKAGES (по умолчанию см. billing/packages.py)
# ============================================
BILLING_PROVIDERS=
YOOKASSA_PROVIDER_TOKEN=
STRIPE_PROVIDER_TOKEN=

# ============================================
# Память: эмбеддинг-модель грузится при первом использовании и выгружается после простоя.
# 0 — грузить при старте и не выгружать. Потолки памяти контейнеров — BOT_MEM_LIMIT / SHOWCASE_MEM_LIMIT
# ============================================
EMBEDDING_IDLE_UNLOAD_SECONDS=600
# BOT_MEM_LIMIT=1280m
# SHOWCASE_MEM_LIMIT=1280m
